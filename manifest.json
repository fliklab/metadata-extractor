{
  "manifest_version": 3,
  "name": "Meta Checker",
  "version": "1.1.0",
  "description": "Extracts metadata from a webpage",
  "permissions": ["activeTab"],
  "background": {
    "type": "module",
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
